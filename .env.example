# --- GCP ---
# GCP project that holds the raw / trusted / refined datasets
GCP_PROJECT_ID=your-gcp-project-id
# Service account dbt impersonates (via ADC)
GCP_SERVICE_ACCOUNT=dbt-transform@your-gcp-project-id.iam.gserviceaccount.com

# --- dbt ---
# dev (default for manual runs) | prod (set by Airflow)
DBT_TARGET=dev

# --- Docker ---
# Pipeline image name:tag, shared by compose and Airflow
PIPELINE_IMAGE=eur-exchange-rates:0.1.0
# Absolute HOST path to your ADC file
# (run: realpath ~/.config/gcloud/application_default_credentials.json)
ADC_PATH=/home/your-user/.config/gcloud/application_default_credentials.json