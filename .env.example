# --- GCP ---
# GCP project that holds the raw / trusted / refined datasets
GCP_PROJECT_ID=your-gcp-project-id
# Service account dbt impersonates (via ADC)
DBT_SERVICE_ACCOUNT=dbt-transform@your-gcp-project-id.iam.gserviceaccount.com

# --- dbt ---
# dev (default for manual runs) | prod (set by Airflow)
DBT_TARGET=dev

# --- Docker ---
# Pipeline image name:tag, shared by compose and Airflow
PIPELINE_IMAGE=eur-exchange-rates:0.1.0

# Absolute HOST path to your user ADC, used by transform
# (dbt impersonates dbt-transform via profiles.yml)
# (run: realpath ~/.config/gcloud/application_default_credentials.json)
ADC_PATH=/home/your-user/.config/gcloud/application_default_credentials.json

# Absolute HOST path to the impersonated ADC for ingest (dlt-loader)
# Create it with:
#   CLOUDSDK_CONFIG=~/.config/gcloud-dlt \
#     gcloud auth application-default login \
#     --impersonate-service-account=dlt-loader@your-gcp-project-id.iam.gserviceaccount.com
# Then: realpath ~/.config/gcloud-dlt/application_default_credentials.json
ADC_PATH_DLT=/home/your-user/.config/gcloud-dlt/application_default_credentials.json