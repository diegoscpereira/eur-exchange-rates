# Required: your user ID in WSL/Linux (run: id -u)
AIRFLOW_UID=1000
# Required: group ID of the host Docker socket
# (run: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=1001

# Optional: defaults shown in compose.yaml if unset
# Local dev only. Override for any shared deployment.
# ADMIN_USER=airflow
# ADMIN_PASSWORD=airflow
# JWT_SECRET=change-me
# FERNET_KEY=